#!name = Anyun VPN
#!desc = Anyun VPN 自动节点订阅
#!date = 2026-06-26
#!author = MrAcT-Cat
#!loon_version = 3.2.4(787)

[Argument]
arg1 = switch,true,tag=自动更新
arg2 = input,"*/20 * * * *",tag=更新周期
arg3 = policy,PROXY,tag=运行策略

[Script]
cron {arg2},script-path=https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/anyunvpn.js,timeout=400,enable={arg1},tag=Anyun自动更新,argument={arg3}
http-request ^https:\/\/sub\.store\/download\/mract,script-path=https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/mract-sub.js,timeout=20,enable={arg1},tag=MrAcT订阅
