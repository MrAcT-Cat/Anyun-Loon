#!name = Anyun VPN
#!desc = Anyun VPN 自动节点订阅
#!author = MrAcT-Cat
#!homepage = https://github.com/MrAcT-Cat/Anyun-Loon
#!openurl = https://sub.store/download/mract
#!system = iOS,iPadOS
#!loon_version = 3.2.4(787)
#!icon = https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/icon.png

[Argument]
arg1 = switch,true,tag=自动更新
arg2 = input,"*/20 * * * *",tag=更新周期
arg3 = policy,DIRECT,tag=运行策略

[Script]
http-request ^https?:\/\/sub\.store\/download\/mract$ script-path=https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/mract-sub.js, timeout=20, enable={arg1}, tag=MrAcT mract订阅

generic script-path=https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/anyunvpn.js, timeout=400, enable={arg1}, tag=Anyun 手动更新, argument={arg3}

cron {arg2} script-path=https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/anyunvpn.js, timeout=400, enable={arg1}, tag=Anyun 自动更新, argument={arg3}
