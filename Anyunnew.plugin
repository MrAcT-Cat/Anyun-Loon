#!name=Anyun VPN
#!desc=Anyun VPN 自动节点订阅
#!author=MrAcT-Cat
#!homepage=https://github.com/MrAcT-Cat/Anyun-Loon
#!openurl=https://sub.store/download/mract
#!system=iOS,iPadOS
#!loon_version=3.2.4(787)
#!tag=VPN,Anyun,订阅
#!type=normal

[Argument]
enabled = switch, true, tag=自动更新, desc=是否启用 Anyun 自动更新
cronExpression = input, "*/20 * * * *", tag=更新周期, desc=Cron 自动更新周期
policyName = policy, DIRECT, tag=运行策略, desc=脚本更新节点时使用的策略组或节点

[Script]
request if ${url} ~= /^https?:\/\/sub\.store\/download\/mract$/i then script("https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/mract-sub.js") with enable=${enabled}, tag="MrAcT mract订阅", timeout=20

generic then script("https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/anyunvpn.js", "${policyName}") with enable=${enabled}, tag="Anyun 手动更新", timeout=400

cron ${cronExpression} then script("https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/anyunvpn.js", "${policyName}") with enable=${enabled}, tag="Anyun 自动更新", timeout=400
