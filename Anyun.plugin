#!name=Anyun VPN
#!desc=Anyun 自动更新订阅
#!system=ios

[Script]

request if ${url} ~= /^https?:\/\/sub\.store\/download\/mract$/i then script("https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/mract-sub.js") with tag="Mract Subscription", timeout=20

generic then script("https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/anyunvpn.js") with tag="Anyun 手动更新", timeout=400

cron "*/20 * * * *" then script("https://raw.githubusercontent.com/MrAcT-Cat/Anyun-Loon/main/anyunvpn.js") with tag="Anyun 自动更新", timeout=400